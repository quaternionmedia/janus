<Window x:Class="Janus.Agent.Gui.GuiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Janus.Agent.Gui.Views"
        Title="Janus.Agent"
        Width="900" Height="550"
        MinWidth="600" MinHeight="350"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GUI/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!--
        Outer Grid wraps the main content + the modal overlay. The modal
        sits later in the document so it draws on top when visible.
        Both Main and Diagnostics tabs (stage 2) will open the same
        modal instance via the ActionsPanel.SettingsRequested bubble.
    -->
    <Grid>

        <!-- ============== TAB CONTENT (single view for stage 1) =========== -->
        <!--
            Stage 1: only MainView. Stage 2 wraps this in a TabControl
            with a DiagnosticsView tab alongside.
        -->
        <views:MainView x:Name="MainViewInstance"/>

        <!-- ============== SETTINGS MODAL OVERLAY =========== -->
        <!--
            Initially Collapsed; the window's code-behind toggles it
            when it catches a bubbled ActionsPanel.SettingsRequested
            event or an Esc key press.
        -->
        <Grid x:Name="SettingsModal" Visibility="Collapsed">
            <Rectangle Fill="#99000000" MouseLeftButtonDown="ModalBackdrop_Click"/>

            <Border Width="520" MaxHeight="460"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Modal header -->
                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,14,8,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="SETTINGS"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Close"
                                    Click="CloseSettings_Click">
                                <TextBlock Text="&#xE8BB;"
                                           FontFamily="{StaticResource IconFont}"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Modal body -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="20,16,20,18">
                        <StackPanel>

                            <!-- CONNECTION -->
                            <TextBlock Text="CONNECTION" Style="{StaticResource SettingsSectionHeader}"/>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Column="0" Grid.Row="0" Text="Baud rate" Style="{StaticResource SettingsLabel}"/>
                                <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding CfgBaud}" Style="{StaticResource SettingsValue}"/>
                                <TextBlock Grid.Column="0" Grid.Row="1" Text="Read timeout" Style="{StaticResource SettingsLabel}"/>
                                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding CfgReadTimeout}" Style="{StaticResource SettingsValue}"/>
                                <TextBlock Grid.Column="0" Grid.Row="2" Text="Write timeout" Style="{StaticResource SettingsLabel}"/>
                                <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding CfgWriteTimeout}" Style="{StaticResource SettingsValue}"/>
                                <TextBlock Grid.Column="0" Grid.Row="3" Text="Read buffer" Style="{StaticResource SettingsLabel}"/>
                                <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding CfgReadBuffer}" Style="{StaticResource SettingsValue}"/>
                                <TextBlock Grid.Column="0" Grid.Row="4" Text="Write buffer" Style="{StaticResource SettingsLabel}"/>
                                <TextBlock Grid.Column="1" Grid.Row="4" Text="{Binding CfgWriteBuffer}" Style="{StaticResource SettingsValue}"/>
                            </Grid>

                            <!-- SWITCH TRIGGERS -->
                            <TextBlock Text="SWITCH TRIGGERS" Style="{StaticResource SettingsSectionHeader}"/>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Column="0" Grid.Row="0" Text="On workstation lock" Style="{StaticResource SettingsLabel}"/>
                                <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding CfgOnLock}" Style="{StaticResource SettingsValue}"/>
                                <TextBlock Grid.Column="0" Grid.Row="1" Text="On shutdown / suspend" Style="{StaticResource SettingsLabel}"/>
                                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding CfgOnShutdown}" Style="{StaticResource SettingsValue}"/>
                                <TextBlock Grid.Column="0" Grid.Row="2" Text="Console key" Style="{StaticResource SettingsLabel}"/>
                                <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding CfgSwitchConsole}" Style="{StaticResource SettingsValue}"/>
                                <TextBlock Grid.Column="0" Grid.Row="3" Text="Global hotkey" Style="{StaticResource SettingsLabel}"/>
                                <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding CfgSwitchHotkey}" Style="{StaticResource SettingsValue}"/>
                            </Grid>

                            <!-- CLIPBOARD -->
                            <TextBlock Text="CLIPBOARD" Style="{StaticResource SettingsSectionHeader}"/>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Column="0" Grid.Row="0" Text="Outbound mode" Style="{StaticResource SettingsLabel}"/>
                                <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding CfgOutboundMode}" Style="{StaticResource SettingsValue}"/>
                                <TextBlock Grid.Column="0" Grid.Row="1" Text="Auto-sync threshold" Style="{StaticResource SettingsLabel}"/>
                                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding CfgAutoSyncBytes}" Style="{StaticResource SettingsValue}"/>
                                <TextBlock Grid.Column="0" Grid.Row="2" Text="Max size" Style="{StaticResource SettingsLabel}"/>
                                <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding CfgMaxBytes}" Style="{StaticResource SettingsValue}"/>
                                <TextBlock Grid.Column="0" Grid.Row="3" Text="Push console key" Style="{StaticResource SettingsLabel}"/>
                                <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding CfgPushConsole}" Style="{StaticResource SettingsValue}"/>
                                <TextBlock Grid.Column="0" Grid.Row="4" Text="Push global hotkey" Style="{StaticResource SettingsLabel}"/>
                                <TextBlock Grid.Column="1" Grid.Row="4" Text="{Binding CfgPushHotkey}" Style="{StaticResource SettingsValue}"/>
                            </Grid>

                            <!-- TIMING -->
                            <TextBlock Text="TIMING" Style="{StaticResource SettingsSectionHeader}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Column="0" Grid.Row="0" Text="Main tick" Style="{StaticResource SettingsLabel}"/>
                                <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding CfgMainTick}" Style="{StaticResource SettingsValue}"/>
                                <TextBlock Grid.Column="0" Grid.Row="1" Text="Reconnect delay" Style="{StaticResource SettingsLabel}"/>
                                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding CfgReconnectDelay}" Style="{StaticResource SettingsValue}"/>
                                <TextBlock Grid.Column="0" Grid.Row="2" Text="Cursor send interval" Style="{StaticResource SettingsLabel}"/>
                                <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding CfgCursorSendInterval}" Style="{StaticResource SettingsValue}"/>
                                <TextBlock Grid.Column="0" Grid.Row="3" Text="Cursor keepalive" Style="{StaticResource SettingsLabel}"/>
                                <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding CfgCursorKeepalive}" Style="{StaticResource SettingsValue}"/>
                                <TextBlock Grid.Column="0" Grid.Row="4" Text="Display refresh" Style="{StaticResource SettingsLabel}"/>
                                <TextBlock Grid.Column="1" Grid.Row="4" Text="{Binding CfgDisplayRefresh}" Style="{StaticResource SettingsValue}"/>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
