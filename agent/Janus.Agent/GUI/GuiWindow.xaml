<Window x:Class="Janus.Agent.Gui.GuiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Janus.Agent.Gui.Views"
        Title="Janus.Agent"
        Width="900" Height="550"
        MinWidth="600" MinHeight="350"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GUI/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>

        <!-- ============== TABS =========== -->
        <!--
            TabControl uses default caching (tab contents stay
            instantiated across tab switches), so each view retains
            its own scroll position, search text, and log state when
            the user flips back and forth.
        -->
        <TabControl x:Name="MainTabs">
            <TabItem Header="Main">
                <views:MainView x:Name="MainViewInstance"/>
            </TabItem>
            <TabItem Header="Diagnostics">
                <views:DiagnosticsView x:Name="DiagViewInstance"/>
            </TabItem>
        </TabControl>

        <!-- ============== SETTINGS MODAL OVERLAY =========== -->
        <Grid x:Name="SettingsModal" Visibility="Collapsed">
            <Rectangle Fill="#99000000" MouseLeftButtonDown="ModalBackdrop_Click"/>

            <Border Width="520" MaxHeight="460"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Modal header -->
                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,14,8,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="SETTINGS"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Close"
                                    Click="CloseSettings_Click">
                                <TextBlock Text="&#xE8BB;"
                                           FontFamily="{StaticResource IconFont}"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Modal body -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="20,16,20,18">
                        <StackPanel>
                            
                            <TextBox Text="CONNECTION" Style="{StaticResource SelectableSettingsSectionHeader}"/>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBox Grid.Column="0" Grid.Row="0" Text="Baud rate" Style="{StaticResource SelectableSettingsLabel}"/>
                                <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding CfgBaud, Mode=OneWay}" Style="{StaticResource SelectableSettingsValue}"/>
                                <TextBox Grid.Column="0" Grid.Row="1" Text="Read timeout" Style="{StaticResource SelectableSettingsLabel}"/>
                                <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding CfgReadTimeout, Mode=OneWay}" Style="{StaticResource SelectableSettingsValue}"/>
                                <TextBox Grid.Column="0" Grid.Row="2" Text="Write timeout" Style="{StaticResource SelectableSettingsLabel}"/>
                                <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding CfgWriteTimeout, Mode=OneWay}" Style="{StaticResource SelectableSettingsValue}"/>
                                <TextBox Grid.Column="0" Grid.Row="3" Text="Read buffer" Style="{StaticResource SelectableSettingsLabel}"/>
                                <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding CfgReadBuffer, Mode=OneWay}" Style="{StaticResource SelectableSettingsValue}"/>
                                <TextBox Grid.Column="0" Grid.Row="4" Text="Write buffer" Style="{StaticResource SelectableSettingsLabel}"/>
                                <TextBox Grid.Column="1" Grid.Row="4" Text="{Binding CfgWriteBuffer, Mode=OneWay}" Style="{StaticResource SelectableSettingsValue}"/>
                            </Grid>

                            <TextBox Text="SWITCH TRIGGERS" Style="{StaticResource SelectableSettingsSectionHeader}"/>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBox Grid.Column="0" Grid.Row="0" Text="On workstation lock" Style="{StaticResource SelectableSettingsLabel}"/>
                                <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding CfgOnLock, Mode=OneWay}" Style="{StaticResource SelectableSettingsValue}"/>
                                <TextBox Grid.Column="0" Grid.Row="1" Text="On shutdown / suspend" Style="{StaticResource SelectableSettingsLabel}"/>
                                <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding CfgOnShutdown, Mode=OneWay}" Style="{StaticResource SelectableSettingsValue}"/>
                                <TextBox Grid.Column="0" Grid.Row="2" Text="Console key" Style="{StaticResource SelectableSettingsLabel}"/>
                                <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding CfgSwitchConsole, Mode=OneWay}" Style="{StaticResource SelectableSettingsValue}"/>
                                <TextBox Grid.Column="0" Grid.Row="3" Text="Global hotkey" Style="{StaticResource SelectableSettingsLabel}"/>
                                <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding CfgSwitchHotkey, Mode=OneWay}" Style="{StaticResource SelectableSettingsValue}"/>
                            </Grid>

                            <TextBox Text="CLIPBOARD" Style="{StaticResource SelectableSettingsSectionHeader}"/>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBox Grid.Column="0" Grid.Row="0" Text="Outbound mode" Style="{StaticResource SelectableSettingsLabel}"/>
                                <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding CfgOutboundMode, Mode=OneWay}" Style="{StaticResource SelectableSettingsValue}"/>
                                <TextBox Grid.Column="0" Grid.Row="1" Text="Auto-sync threshold" Style="{StaticResource SelectableSettingsLabel}"/>
                                <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding CfgAutoSyncBytes, Mode=OneWay}" Style="{StaticResource SelectableSettingsValue}"/>
                                <TextBox Grid.Column="0" Grid.Row="2" Text="Max size" Style="{StaticResource SelectableSettingsLabel}"/>
                                <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding CfgMaxBytes, Mode=OneWay}" Style="{StaticResource SelectableSettingsValue}"/>
                                <TextBox Grid.Column="0" Grid.Row="3" Text="Push console key" Style="{StaticResource SelectableSettingsLabel}"/>
                                <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding CfgPushConsole, Mode=OneWay}" Style="{StaticResource SelectableSettingsValue}"/>
                                <TextBox Grid.Column="0" Grid.Row="4" Text="Push global hotkey" Style="{StaticResource SelectableSettingsLabel}"/>
                                <TextBox Grid.Column="1" Grid.Row="4" Text="{Binding CfgPushHotkey, Mode=OneWay}" Style="{StaticResource SelectableSettingsValue}"/>
                            </Grid>

                            <TextBox Text="TIMING" Style="{StaticResource SelectableSettingsSectionHeader}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBox Grid.Column="0" Grid.Row="0" Text="Main tick" Style="{StaticResource SelectableSettingsLabel}"/>
                                <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding CfgMainTick, Mode=OneWay}" Style="{StaticResource SelectableSettingsValue}"/>
                                <TextBox Grid.Column="0" Grid.Row="1" Text="Reconnect delay" Style="{StaticResource SelectableSettingsLabel}"/>
                                <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding CfgReconnectDelay, Mode=OneWay}" Style="{StaticResource SelectableSettingsValue}"/>
                                <TextBox Grid.Column="0" Grid.Row="2" Text="Cursor send interval" Style="{StaticResource SelectableSettingsLabel}"/>
                                <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding CfgCursorSendInterval, Mode=OneWay}" Style="{StaticResource SelectableSettingsValue}"/>
                                <TextBox Grid.Column="0" Grid.Row="3" Text="Cursor keepalive" Style="{StaticResource SelectableSettingsLabel}"/>
                                <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding CfgCursorKeepalive, Mode=OneWay}" Style="{StaticResource SelectableSettingsValue}"/>
                                <TextBox Grid.Column="0" Grid.Row="4" Text="Display refresh" Style="{StaticResource SelectableSettingsLabel}"/>
                                <TextBox Grid.Column="1" Grid.Row="4" Text="{Binding CfgDisplayRefresh, Mode=OneWay}" Style="{StaticResource SelectableSettingsValue}"/>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
