<UserControl x:Class="Janus.Agent.Gui.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Janus.Agent.Gui.Shared">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GUI/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ SIDEBAR ============ -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="18,18,18,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBox Text="DIAGNOSTICS"
                             Style="{StaticResource SelectableText}"
                             FontSize="10.5"
                             Foreground="{StaticResource MutedBrush}"
                             FontWeight="Medium"
                             Margin="0,0,0,10"/>

                    <!--
                        Sub-nav item stays a RadioButton (interactive
                        control, not text to copy). GroupName ties
                        future siblings (Metrics etc.) so only one is
                        selected at a time.
                    -->
                    <RadioButton Style="{StaticResource SubNavItem}"
                                 GroupName="DiagSubNav"
                                 IsChecked="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D5;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="Logs" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <Grid Grid.Row="1"/>

                <shared:ActionsPanel Grid.Row="2"/>
            </Grid>
        </Border>

        <!-- ============ LOG ============ -->
        <Grid Grid.Column="1" Background="{StaticResource BodyBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,10,14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="LOG"
                             Style="{StaticResource SelectableText}"
                             FontSize="10.5"
                             Foreground="{StaticResource MutedBrush}"
                             FontWeight="Medium"
                             Margin="0,2,16,0"
                             VerticalAlignment="Center"/>

                    <Grid Grid.Column="1" Width="220" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource DarkTextBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                        <TextBlock IsHitTestVisible="False"
                                   Text="filter log&#x2026;"
                                   Foreground="{StaticResource FaintBrush}"
                                   FontFamily="Cascadia Mono, Consolas, Lucida Console, Courier New"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <CheckBox Grid.Column="3"
                            x:Name="WordWrapCheck"
                            IsChecked="True"
                            VerticalAlignment="Center"
                            Style="{StaticResource LabelCheckBoxWordWrap}"
                            Margin="0,0,14,0"
                            Click="WordWrapCheck_Click"/>
                    <CheckBox Grid.Column="4"
                              x:Name="AutoScrollCheck"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Style="{StaticResource LabelCheckBox}"
                              Click="AutoScrollCheck_Click"/>
                </Grid>
            </Border>

            <RichTextBox x:Name="LogView"
                         Grid.Row="1"
                         Style="{StaticResource LogRichTextBox}"/>
        </Grid>
    </Grid>
</UserControl>
